<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Elevare Portfolio</title>
    <style>
        /* Force the body to take up the full screen with no scrollbars */
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #636363;
        }

        .wrapper {
            position: relative;
            width: 100%;
            height: 100vh; /* Viewport Height */
            display: block;
        }

        /* Ensure the iframe fills the wrapper entirely */
        iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
        }

        /* The Patch: Positioned specifically over the bottom-left watermark */
        .mask {
            position: absolute;
            bottom: 10px;
            left: 10px;
            width: 170px;
            height: 70px;
            background-color: #636363; /* Matches the Heyzine background */
            z-index: 9999;
            pointer-events: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .mask-content {
            color: #ffffff;
            font-family: Arial, sans-serif;
            font-size: 11px;
            font-weight: bold;
            letter-spacing: 2px;
            opacity: 0.3;
        }
    </style>
</head>
<body>

    <div class="wrapper">
        <iframe src="https://heyzine.com/flip-book/1f268b08d8.html" allowfullscreen></iframe>

        <div class="mask">
            <div class="mask-content">ELEVARE</div>
        </div>
    </div>

</body>
</html>
